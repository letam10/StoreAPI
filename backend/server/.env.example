# Host Visual Studio truyền các giá trị trong appsettings.json vào Node trước file này.
PORT=3011
PGDATA_PATH=data/pgdata
ENABLE_DEMO_DATA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
SUPPORT_NUM_CTX=8192
ADMIN_DEFAULT_NUM_CTX=16384
SUPPORT_NUM_PREDICT=384
ADMIN_NUM_PREDICT=4096
OLLAMA_TIMEOUT_MS=120000
GENERATION_QUEUE_MAX=4
GENERATION_QUEUE_WAIT_MS=30000
COOKIE_SECURE=false
PAYMENT_WEBHOOK_SECRET=
# Mặc định dùng PGlite. Chỉ thêm DATABASE_URL/PG variables nếu đã chuyển database có chủ đích.

